    {
     "kind": "expr",
     "name": "llm_overnight_gap_reversal",
     "expr": "Div(Mean(Div(Sub($open,$pre_close),$pre_close),5), Add(Std(Div(Sub($open,$pre_close),$pre_close),20),0.001))",
     "why": "微盘隔夜跳空由散户注意力驱动，持续高开且波动大者次月反转。",
     "noise_hypothesis": "用 pre_close 归一化剥离价格水平与市场整体跳空，只留个股隔夜情绪。"
    },
    {
     "kind": "expr",
     "name": "llm_open_drive_fade",
     "expr": "Sub(Mean(Div(Sub($close,$open),Add(Sub($high,$low),0.001)),5), Mean(Div(Sub($open,$pre_close),$pre_close),5))",
     "why": "开盘冲高但收盘弱反映日内诱多，微盘散户接盘后次月回落。",
     "noise_hypothesis": "用日内振幅归一化，避免高低价绝对区间和微盘价格噪声。"
    },
    {
     "kind": "expr",
     "name": "llm_max_lottery_neg",
     "expr": "Sub(0, Max(Div(Sub($close,$pre_close),Add($pre_close,0.001)),20))",
     "why": "微盘彩票偏好，过去20日单日最大涨幅越高，次月越可能被高估回落。",
     "noise_hypothesis": "用 pre_close 归一化去除价格水平，MAX 只提取极端正收益。"
    },
    {
     "kind": "expr",
     "name": "llm_idio_skew_neg",
     "expr": "Sub(0, Div(Mean(Pow(Sub(Div($close,$pre_close),1),3),20), Add(Pow(Std(Div($close,$pre_close),20),3),0.001)))",
     "why": "微盘正偏度吸引彩票型资金，正偏度高者未来收益低。",
     "noise_hypothesis": "除以波动率三次方，剥离整体波动水平，保留偏度形状。"
    },
    {
     "kind": "expr",
     "name": "llm_downside_vol_asym",
     "expr": "Div(Std(Mul(Div(Sub($close,$pre_close),$pre_close), Less(Div(Sub($close,$pre_close),$pre_close),0)),20), Add(Std(Mul(Div(Sub($close,$pre_close),$pre_close), Greater(Div(Sub($close,$pre_close),$pre_close),0)),20),0.001))",
     "why": "微盘下行波动占比高代表恐慌与流动性脆弱，低则被忽视；该比值度量下行风险不对称。",
     "noise_hypothesis": "上下行收益分开，避免总波动率被涨跌停和微盘噪声主导。"
    },
    {
     "kind": "expr",
     "name": "llm_clv_reversal",
     "expr": "Sub(0, Mean(Div(Sub(Mul(2,$close),Add($high,$low)), Add(Sub($high,$low),0.001)),20))",
     "why": "收盘持续位于日内区间上沿表示买压过度，微盘次月易反转。",
     "noise_hypothesis": "日内位置归一化，避免跳空和绝对价格水平噪声。"
    },

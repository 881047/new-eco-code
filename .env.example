# 复制成 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
#   在 Windows 上:  copy .env.example .env
#
# Tushare 数据接口 token（必需：缺它 app/datasource/tushare_client.py 直接抛错）
TUSHARE_TOKEN=
#
# QQ/163 邮箱 SMTP **授权码**（可选：只用邮件推送时需要；不是登录密码）
# 优先住这里；config.yaml 的 email.auth_code 必须留空（save_config 会硬拒明文写入）
EMAIL_AUTH_CODE=
#
# 大模型（可选：看板问答 /api/llm/ask 与因子审读 scripts/llm_factor_review.py 用）
# ⚠️ base_url 走**主机白名单**，不是"任意 OpenAI 兼容接口"（2026-09-18 审查 Q-03）：
#   服务端会向它发 `Authorization: Bearer {LLM_API_KEY}`，只校验格式等于给 key
#   开一条静默外传通道。白名单在 app/web/llm.py 的 _ALLOWED_LLM_HOSTS，
#   目前是 api.deepseek.com / api.openai.com / 127.0.0.1 / localhost（本地代理、
#   本地 vLLM 走 127.0.0.1 仍然可用）。要加智谱/Kimi 等新主机：改那一行常量，
#   并同步知识库 03 号「本机安全姿态」。
# key 只住这里（.gitignore 覆盖）；未配置时看板自动退回本地规则问答，零影响。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
#
# 同花顺财经开放平台 key（可选：缺它只跳过龙虎榜同步，app/datasource/lhb_client.py
# 会 log.warning 后继续跑，不报错 —— 所以缺键的表现是"龙虎榜永远不更新"，很安静）
HITHINK_FINANCE_API_KEY=
#
# 服务监听端口（可选：不设 = 8787，行为与从前逐字一致）
# 2026-09-22：原先 8787 硬编码散在 8+ 处（app/notify.py 的看板链接、看门狗探活与拉起、
#   start.bat 的 4 处、vite dev proxy…）⇒ 改端口要改一堆地方，漏一处的症状是**静默的**
#   （探活探错端口 ⇒ 看门狗误判"服务不在"并重复拉起；邮件里看板链接打不开）。
#   现在只有这一个口径。默认值由 tests/test_port_single_source.py 钉住一致。
# ⚠️ 改端口后：start.bat / 看门狗 / 邮件链接会自动跟上；**前端不需要重建**
#   （生产产物全走相对路径 `/api/...`，由同一个服务端出静态文件）；
#   只有 `npm run dev` 时要在同一个环境里设同一个值。
NEWECO_PORT=
